\@writefile{toc}{\contentsline {section}{\numberline {6}Conclusion}{4}{section.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces PointProgrammerNet architecture. The shared encoder writes each observation into three equal-size additive FWP states, after which the historical point list can be discarded. For segmentation, the states are read at a query coordinate and combined with a direct coordinate skip. For classification, soft row summaries from the fine and broad states form a bounded residual around the middle-state summary. Neither head pools over decoded points.}}{5}{figure.1}\protected@file@percent }
\newlabel{fig:architecture}{{1}{5}{PointProgrammerNet architecture. The shared encoder writes each observation into three equal-size additive FWP states, after which the historical point list can be discarded. For segmentation, the states are read at a query coordinate and combined with a direct coordinate skip. For classification, soft row summaries from the fine and broad states form a bounded residual around the middle-state summary. Neither head pools over decoded points}{figure.1}{}}
\newlabel{fig:architecture@cref}{{[figure][1][]1}{[1][2][]5}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Additive streaming and fixed retained memory. Ordered and shuffled chunk writes reproduce the single-batch FWP state up to floating-point accumulation error. The three $128\times 170$ float32 states occupy 255 KiB regardless of stream length, whereas stored XYZ coordinates grow linearly with the number of observations.}}{6}{figure.2}\protected@file@percent }
\newlabel{fig:additivity_fixed_state}{{2}{6}{Additive streaming and fixed retained memory. Ordered and shuffled chunk writes reproduce the single-batch FWP state up to floating-point accumulation error. The three $128\times 170$ float32 states occupy 255 KiB regardless of stream length, whereas stored XYZ coordinates grow linearly with the number of observations}{figure.2}{}}
\newlabel{fig:additivity_fixed_state@cref}{{[figure][2][]2}{[1][3][]6}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Streaming state operations. (a) Maximum relative errors for append/merge, frame removal, and exponential decay, measured against independently reconstructed FWP states on 32 ShapeNetPart objects. (b) Ordinary addition increases the state magnitude with the number of frames, while exponential decay limits the influence of older frames without changing state size.}}{6}{figure.3}\protected@file@percent }
\newlabel{fig:streaming-state-operations}{{3}{6}{Streaming state operations. (a) Maximum relative errors for append/merge, frame removal, and exponential decay, measured against independently reconstructed FWP states on 32 ShapeNetPart objects. (b) Ordinary addition increases the state magnitude with the number of frames, while exponential decay limits the influence of older frames without changing state size}{figure.3}{}}
\newlabel{fig:streaming-state-operations@cref}{{[figure][3][]3}{[1][3][]6}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces FWP state-construction cost for device-resident point streams. (a) An incremental update processes one new 256-point frame, whereas reconstruction processes every accumulated point. Values are median wall-clock latency over seven interleaved trials of 30 repetitions for four streams; whiskers show the observed range. (b) The speedup grows with history length, while incremental and reconstructed states remain numerically equivalent.}}{7}{figure.4}\protected@file@percent }
\newlabel{fig:streaming-efficiency}{{4}{7}{FWP state-construction cost for device-resident point streams. (a) An incremental update processes one new 256-point frame, whereas reconstruction processes every accumulated point. Values are median wall-clock latency over seven interleaved trials of 30 repetitions for four streams; whiskers show the observed range. (b) The speedup grows with history length, while incremental and reconstructed states remain numerically equivalent}{figure.4}{}}
\newlabel{fig:streaming-efficiency@cref}{{[figure][4][]4}{[1][3][]7}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Three-seed screening ablations. (a) For segmentation, separated initial radii improve equal partition states, and a common partition-key formulation improves the multiscale mixed-key control. (b) For state-only classification, the middle-reference residual improves clean and density-shift accuracy over direct concatenation; a higher learning rate for the middle radius further improves shifted accuracy. Bars show paired mean changes and whiskers show population standard deviations. Each screening run uses five epochs.}}{7}{figure.5}\protected@file@percent }
\newlabel{fig:architecture_ablation}{{5}{7}{Three-seed screening ablations. (a) For segmentation, separated initial radii improve equal partition states, and a common partition-key formulation improves the multiscale mixed-key control. (b) For state-only classification, the middle-reference residual improves clean and density-shift accuracy over direct concatenation; a higher learning rate for the middle radius further improves shifted accuracy. Bars show paired mean changes and whiskers show population standard deviations. Each screening run uses five epochs}{figure.5}{}}
\newlabel{fig:architecture_ablation@cref}{{[figure][5][]5}{[1][3][]7}{}{}{}}
