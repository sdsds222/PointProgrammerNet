\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Properties retained by families of set summaries. ``Order-free write'' means the summary does not depend on the order in which points are absorbed; ``additive state'' means the summary of a union equals the sum of the summaries; ``bounded state'' means retained memory does not grow with the number of observed points; ``coordinate read'' means the summary alone can be evaluated at a requested position.}}{4}{table.1}\protected@file@percent }
\newlabel{tab:family-comparison}{{1}{4}{Properties retained by families of set summaries. ``Order-free write'' means the summary does not depend on the order in which points are absorbed; ``additive state'' means the summary of a union equals the sum of the summaries; ``bounded state'' means retained memory does not grow with the number of observed points; ``coordinate read'' means the summary alone can be evaluated at a requested position}{table.1}{}}
\newlabel{tab:family-comparison@cref}{{[table][1][]1}{[1][3][]4}}
